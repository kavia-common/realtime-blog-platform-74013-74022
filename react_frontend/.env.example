# Client-safe environment variables for the frontend (Vite exposes VITE_* to the browser)

# Clerk (Authentication)
# Obtain from Clerk Dashboard → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Convex (Realtime backend)
# Use your Convex deployment origin (https://<your-deployment>.convex.cloud)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: public base URL of this frontend (for SEO canonical links and share URLs)
# Example (dev): http://localhost:3000
# Example (prod): https://blog.example.com
VITE_PUBLIC_BASE_URL=http://localhost:3000

# Optional: file upload settings. When you implement a Convex HTTP upload endpoint, enable:
# - VITE_UPLOAD_BACKEND=convex
# - VITE_UPLOAD_MAX_SIZE_MB=10
VITE_UPLOAD_BACKEND=
VITE_UPLOAD_MAX_SIZE_MB=10
