# Realtime Blog Frontend — Environment Example
# Copy this file to ".env" and fill in the values for your environment.
# Vite exposes only variables prefixed with VITE_ to client code.

# Clerk (Authentication)
# Obtain from Clerk Dashboard → Your application → API Keys.
# Publishable Key is safe for the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Convex (Backend)
# Deployment URL can be found in convex.json or in Convex dashboard after deploying.
# It typically looks like: https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Public Base URL (optional but recommended)
# Used to generate absolute URLs for sharing links and SEO. In development
# this will default to the dev server origin if not set.
# Example for local dev: http://localhost:3000
# Example for production: https://blog.example.com
VITE_PUBLIC_BASE_URL=

# Upload Storage Configuration (placeholder)
# The current code falls back to temporary object URLs for images.
# When wiring a real upload backend (Convex storage or UploadThing), add the relevant
# keys here for your chosen provider. These keys are READABLE BY THE BROWSER if
# prefixed with VITE_, so do not put secrets that must remain server-side.
#
# Example (UploadThing - client publishable key):
# VITE_UPLOADTHING_APP_ID=XXXXXXXX
# VITE_UPLOADTHING_PUBLIC_API_KEY=XXXXXXXX
#
# Example (Convex HTTP upload endpoint toggle):
# VITE_UPLOAD_BACKEND=convex
# VITE_UPLOAD_MAX_SIZE_MB=10
