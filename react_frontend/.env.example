# Frontend environment variables (Vite exposes only VITE_* to the browser)
# Request real values from the user / orchestrator. Do NOT commit secrets.

# Clerk publishable key (from Clerk Dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Convex deployment URL (origin)
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Optional: public base URL of this frontend (for absolute links/SEO)
VITE_PUBLIC_BASE_URL=http://localhost:3000

# Optional: upload backend selector ("convex" to use a Convex HTTP endpoint)
#VITE_UPLOAD_BACKEND=convex

# Optional: upload config (example for UploadThing or similar providers)
#VITE_UPLOADTHING_APP_ID=your_app_id
#VITE_UPLOADTHING_PUBLIC_API_KEY=public_key
