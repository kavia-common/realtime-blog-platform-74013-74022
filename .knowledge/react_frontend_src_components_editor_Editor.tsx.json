{"is_source_file": true, "format": "TypeScript/TSX", "description": "This file defines a React component called RichEditor, which implements a rich text editor using the TipTap library. It includes configuration for various extensions like placeholders, link support, image uploading, and syntax-highlighted code blocks. The component provides props for initial content, change callbacks, image upload handling, and customization. It handles drag-and-drop and clipboard pasted images, performing uploads via provided functions, and updates the editor's content accordingly.", "external_files": ["@tiptap/react", "@tiptap/starter-kit", "@tiptap/extension-placeholder", "@tiptap/extension-link", "@tiptap/extension-image", "@tiptap/extension-code-block-lowlight", "../../lib/lowlight-shim", "./utils", "./Toolbar", "./tiptap.css"], "external_methods": ["lowlight.highlight"], "published": ["RichEditorProps", "RichEditor"], "classes": [], "methods": [{"name": "RichEditor", "description": "React functional component that initializes and renders a rich text editor with toolbar, supports image upload, pasted images, and content change callbacks."}], "calls": ["lowlight.highlight", "window.alert", "editor.commands.setContent", "editor.chain", "editor.chain().focus().setImage"], "search-terms": ["TipTap", "Rich Text Editor", "Image Upload", "Syntax Highlighting", "React", "Editor Initialization", "Drag-and-Drop Image", "Content JSON"], "state": 2, "file_id": 43, "knowledge_revision": 334, "git_revision": "cbf13006ebc084e51a09bbe4b8e35f025bb00d9b", "revision_history": [{"130": ""}, {"140": ""}, {"144": ""}, {"147": ""}, {"148": ""}, {"149": ""}, {"150": ""}, {"151": ""}, {"152": ""}, {"153": ""}, {"154": ""}, {"155": "a9716cf923317a70563997d1edafe689cdaddeef"}, {"160": "a9716cf923317a70563997d1edafe689cdaddeef"}, {"166": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"167": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"168": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"171": "b7808b5cd