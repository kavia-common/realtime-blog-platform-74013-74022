{"is_source_file": true, "format": "TypeScript", "description": "This file defines a React component called RichEditor which is a rich text editor built on the TipTap library. It includes configuration for various extensions such as code blocks, images, links, and placeholders. It handles image uploads via drag-and-drop, paste, or URL input, and emits JSON representations of the document state. It also provides a toolbar with image insertion capabilities.", "external_files": ["../../lib/lowlight-shim", "./utils", "./Toolbar", "tiptap.css"], "external_methods": ["useEditor", "EditorContent"], "published": ["RichEditorProps", "RichEditor"], "classes": [], "methods": [{"name": "RichEditor", "description": "Main React component implementing a rich text editor with configurable content and upload handlers. Manages editor initialization, content updates, and image handling."}], "calls": ["useMemo", "useRef", "useEditor", "editor.commands.setContent", "editor.chain", "editor.focus", "editor.setImage", "editor.getJSON"], "search-terms": ["TipTap React Editor", "Rich text editor", "Image upload", "ProseMirror JSON", "Editor extensions", "Image handling", "Drag-and-drop image", "Placeholder extension", "Link extension", "Code block highlighting", "RichEditor component"], "state": 2, "file_id": 43, "knowledge_revision": 684, "git_revision": "0b5b00fcf9848ebb46a2845c7657acfd5a064838", "revision_history": [{"130": ""}, {"140": ""}, {"144": ""}, {"147": ""}, {"148": ""}, {"149": ""}, {"150": ""}, {"151": ""}, {"152": ""}, {"153": ""}, {"154": ""}, {"155": "a9716cf923317a70563997d1edafe689cdaddeef"}, {"160": "a9716cf923317a70563997d1edafe689cdaddeef"}, {"166": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"167": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"168": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"171": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"172": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"173": "b7808b5cd157a5687edfe10670425a28c90bdd46"}, {"178": "b7808b5