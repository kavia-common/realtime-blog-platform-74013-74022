{"is_source_file": true, "format": "TypeScript/TSX", "description": "This file defines a React component named `RichEditor`, which is a rich text editor built with the Tiptap library. The component supports features like headings, formatting, code blocks with syntax highlighting, lists, links, images with upload functionality, drag-and-drop, and paste image uploads. It manages editor state, handles image uploads via clipboard or file input, and emits JSON representations of the content on changes. The file also imports styling and utility modules, and provides an interface for props configuration.", "external_files": ["@tiptap/react", "@tiptap/starter-kit", "@tiptap/extension-placeholder", "@tiptap/extension-link", "@tiptap/extension-image", "../../lib/lowlight-shim", "./utils", "./Toolbar", "./tiptap.css"], "external_methods": ["TiptapEditor.prototype.getJSON", "TiptapEditor.prototype.commands.setContent", "TiptapEditor.prototype.chain", "TiptapEditor.prototype.focus", "TiptapEditor.prototype.setImage", "window.prompt", "window.alert", "URL.createObjectURL", "URL.revokeObjectURL"], "published": ["RichEditor", "RichEditorProps", "TipTapJSON"], "classes": [], "methods": [{"name": "RichEditor", "description": "React functional component that initializes and manages a Tiptap editor instance with rich text editing features and image upload support."}], "calls": ["useState", "useCallback", "useEffect", "useMemo", "useRef", "setEditor", "instance.destroy", "editor.commands.setContent", "editor.chain().focus().setImage().run", "editor.getJSON", "view.dispatch", "view.state.doc.descendants", "URL.createObjectURL", "URL.revokeObjectURL"], "search-terms": ["React rich text editor", "TipTap editor", "image upload", "React useCallback", "React useEffect", "editor content JSON", "editor extension configuration"], "state": 2, "file_id": 43, "knowledge_revision": 222, "git_revision": "3a0f355d5db526fc8beee8369acd5164c179be61", "revision_history": [{"130": ""}, {"140": ""}, {"144":